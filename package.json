{
  "name": "roadmap-starter",
  "version": "1.0.1",
  "description": "Roadmap Starter WordPress theme",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "cross-env NODE_ENV=production npx webpack --config webpack.config.js",
    "production": "npm run build",
    "package": "npm run build && THEME=$(basename \"$(pwd)\") && VERSION=$(grep -m 1 'Version:' style.css | sed 's/.*Version:[[:space:]]*//' | tr -d '[:space:]') && cd .. && rm -f \"$THEME-v$VERSION.zip\" && zip -1Tr \"$THEME-v$VERSION.zip\" \"$THEME\" -x \"$THEME/.*\" -x \"$THEME/node_modules/*\" -x \"$THEME/tmp/*\"",
    "watch": "npx webpack --config webpack.config.js --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^8.6.5",
    "babel-core": "^6.26.3",
    "babel-loader": "^9.1.3",
    "babel-preset-env": "^1.7.0",
    "bootstrap": "^5.3.0",
    "browser-sync": "^2.26.3",
    "browser-sync-webpack-plugin": "^2.2.2",
    "clean-webpack-plugin": "^1.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^0.28.11",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "exports-loader": "^0.7.0",
    "file-loader": "^6.2.0",
    "glob": "^7.1.3",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss-loader": "^7.3.3",
    "precss": "^4.0.0",
    "resolve-url-loader": "^3.0.0",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.2",
    "sharp": "^0.35.2",
    "slick-carousel": "^1.8.1",
    "style-loader": "^0.20.3",
    "svgo": "^4.0.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-react": "^7.22.5",
    "@popperjs/core": "^2.11.8",
    "cross-env": "^5.2.0",
    "imagesloaded": "^4.1.4",
    "isdev": "^1.0.1",
    "masonry-layout": "^4.2.2",
    "sass-glob-importer": "^1.0.1"
  }
}
